{
  "name": "ai-reckoning",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An interactive, data-driven investigation into the economics, capital flows and market repricing of artificial intelligence.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:data": "node scripts/check-data.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "d3-array": "3.2.5",
    "d3-format": "3.1.3",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "marked": "18.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/d3-array": "3.2.2",
    "@types/d3-format": "3.0.4",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
