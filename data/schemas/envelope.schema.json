{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publication artifact envelope",
  "type": "object",
  "required": ["schema_version", "artifact", "generated_utc", "source_cutoff_date", "methodology_version", "units", "missing_value_convention", "data"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "artifact": { "type": "string" },
    "generated_utc": { "type": "string" },
    "source_cutoff_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "methodology_version": { "type": "string" },
    "units": { "type": "object" },
    "missing_value_convention": { "type": "string" }
  }
}
