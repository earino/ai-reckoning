{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relationship edge",
  "type": "object",
  "required": ["id", "source", "target", "type", "description", "announced_amount", "realized_amount", "currency", "amount_state", "status", "source_url", "confidence", "cancelled"],
  "properties": {
    "type": { "enum": ["equity_investment", "debt_financing", "compute_purchase", "hardware_purchase", "cloud_service", "power_procurement", "capacity_commitment", "ownership_revenue_share"] },
    "status": { "enum": ["completed", "ongoing", "announced", "conditional", "estimated"] },
    "amount_state": { "enum": ["undisclosed", "stake_value_not_cash", "annual_run_rate", "ceiling", "contract_total"] },
    "announced_amount": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "realized_amount": { "type": ["number", "null"], "minimum": 0 },
    "comparable_amount": { "type": ["number", "null"] },
    "source_url": { "type": "string", "pattern": "^https?://" },
    "confidence": { "enum": ["high", "medium", "low"] },
    "currency": { "const": "USD" }
  }
}
